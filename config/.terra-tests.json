{
  "version": 1,
  "suites": [
    {
      "name": "unit",
      "command": "pnpm",
      "args": ["test"],
      "owns": ["tests/*.test.mjs"]
    },
    {
      "name": "browser",
      "command": "pnpm",
      "args": ["run", "test:browser"],
      "owns": ["tests/browser"]
    },
    {
      "name": "consumer",
      "command": "pnpm",
      "args": ["run", "test:consumer"],
      "owns": ["tests/consumer-browser"]
    }
  ]
}
