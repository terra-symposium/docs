{
	"$schema": "./node_modules/@terra-symposium/hygiene/quality.schema.json",
	"sourceRoots": ["."],
	"skippedDirectories": [".astro", ".git", "dist", "node_modules", "template/.astro", "template/dist"],
	"extensions": [".astro", ".cjs", ".css", ".html", ".js", ".jsx", ".md", ".mdx", ".mjs", ".ts", ".tsx"],
	"tsconfig": "tsconfig.json",
	"lintRoots": ["."],
	"typecheckCommand": {
		"command": "pnpm",
		"args": ["run", "typecheck"]
	},
	"tools": {
		"eslint": "eslint",
		"knip": "knip",
		"prettier": "prettier",
		"tsc": "tsc"
	},
	"oneLineImports": true,
	"documentation": {
		"commandRoots": ["README.md", "docs"],
		"required": {
			"types": true,
			"functions": false,
			"exportedFunctions": true,
			"noInlineFunctions": false
		}
	},
	"frameworkEntryExports": {
		"site/src/components/DocsSiteIsland.tsx": ["DocsSiteIsland"]
	},
	"enabledChecks": {
		"accessibility": true,
		"display-name": true,
		"documented-commands": true
	}
}
