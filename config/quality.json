{
  "$schema": "../node_modules/@terra-symposium/standards-quality/quality.schema.json",
  "root": ".",
  "tsconfig": "config/tsconfig.json",
  "sourceRoots": ["."],
  "languageProfiles": ["c", "java", "python"],
  "extensions": [
    ".astro",
    ".c",
    ".cjs",
    ".cpp",
    ".cts",
    ".css",
    ".h",
    ".html",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".jsonc",
    ".md",
    ".mdx",
    ".mjs",
    ".mts",
    ".py",
    ".pyi",
    ".rs",
    ".sh",
    ".sql",
    ".toml",
    ".ts",
    ".tsx",
    ".yaml",
    ".yml"
  ],
  "tools": {
    "eslint": "node_modules/.bin/eslint"
  },
  "regexDedup": {
    "minimumCount": 2,
    "sharedModule": "src/lib/terra/regex.mjs"
  },
  "tailwindCanonical": {
    "stylesheet": "src/styles/style.css"
  },
  "repeatedClasses": {
    "minimumCount": 3
  },
  "uiPatterns": {
    "forbidden": [
      "<[^>]*\\brole\\s*=\\s*['\"]dialog['\"]",
      "\\baria-modal\\s*=",
      "\\bcreatePortal\\s*\\("
    ]
  },
  "frameworkEntryExports": {
    "site/src/components/DocsSiteIsland.tsx": ["DocsSiteIsland"],
    "src/components/Docs.tsx": ["Docs", "DocsMode", "DocsProps", "DocsValue"],
    "src/components/LocalDocsWorkspace.tsx": [
      "DocsLocalWorkspace",
      "DocsLocalPage",
      "DocsLocalWorkspaceProps",
      "findDocsLocalPage"
    ],
    "src/components/SiteLayout.tsx": ["DocsSiteLayout"],
    "src/components/StaticWorkspace.tsx": ["DocsStaticWorkspace"],
    "src/components/blocks.tsx": [
      "DOCS_BLOCK_FIELDS",
      "DOCS_BLOCK_TYPES",
      "defaultDocsBlock",
      "DocsRichBlock",
      "enabledDocsBlocks",
      "DocsBlockOptions",
      "DocsBlockType",
      "RichBlock"
    ],
    "src/components/navigation.tsx": ["DocsNavigation", "DocsNavNode"],
    "src/components/quiz.tsx": [
      "DocsQuizGenerator",
      "parseDocsQuiz",
      "DocsQuizConfig",
      "DocsQuizDocument",
      "DocsQuizGenerationInput",
      "DocsQuizQuestion",
      "DocsQuizQuestionType"
    ],
    "src/components/terra/Workspace.tsx": ["DocsWorkspace"],
    "src/components/terra/editor/ContentEditor.tsx": ["ContentEditor"],
    "src/components/terra/editor/docs/_Callout.tsx": ["renderCallout"],
    "src/components/terra/editor/docs/_DocsCode.tsx": ["renderCode"],
    "src/components/terra/editor/docs/_Embed.tsx": ["Embed"],
    "src/components/terra/editor/docs/_DocsImage.tsx": ["renderImage"],
    "src/components/terra/editor/docs/_Math.tsx": ["renderMathBlock"],
    "src/components/terra/editor/docs/_Nodes.tsx": ["NodesBlock"],
    "src/components/terra/editor/docs/_Raw.tsx": ["Raw"],
    "src/components/terra/editor/docs/_Table.tsx": ["renderTable"],
    "src/components/terra/editor/docs/_Tabs.tsx": ["renderSections"],
    "src/components/terra/editor/docs/_TsDocs.tsx": ["TsDocs"],
    "src/components/terra/editor/docs/heading.tsx": ["DocsHeading"],
    "src/components/terra/pages/docs/_icons.tsx": ["DOCS_BLOCK_ICONS"],
    "src/components/terra/pages/docs/_export-dialog.tsx": ["ExportDialog"],
    "src/components/workspace-demo-fixture.ts": ["createWorkspaceDemoHost"],
    "src/lib/host-runtime.ts": ["configureDocsHost", "getDocsHostAdapter"],
    "src/lib/host.ts": [
      "DocsActionOperation",
      "DocsActionResult",
      "DocsHostOperationContracts",
      "DocsResolvedRoute",
      "DocsCustomBlock",
      "DocsHostAdapter",
      "DocsHostAttachment",
      "DocsHostCapabilities",
      "DocsHostDocument",
      "DocsHostTreeNode",
      "DocsHostUser",
      "DocsWorkspaceProps"
    ],
    "src/lib/markdown-model.ts": ["markdownToDocsValue", "docsValueToMarkdown"],
    "src/lib/markdown.ts": ["renderMarkdown"],
    "src/lib/terra/docs/attachments.ts": ["ATTCH_TYPES"],
    "src/lib/terra/runtime/types.ts": ["DocsExportOpts", "ExportTgt"],
    "src/lib/workspace-types.ts": ["DocsAttachment", "DocsLeaf", "DocsGroup", "DocsSection"],
    "src/lib/index.ts": [
      "Docs",
      "DocsSiteLayout",
      "DocsStaticWorkspace",
      "DocsMode",
      "DocsProps",
      "DocsValue",
      "DocsNavigation",
      "DocsNavNode",
      "renderMarkdown",
      "markdownToDocsValue",
      "docsValueToMarkdown",
      "DOCS_BLOCK_TYPES",
      "DOCS_BLOCK_FIELDS",
      "enabledDocsBlocks",
      "defaultDocsBlock",
      "DocsRichBlock",
      "DocsBlockOptions",
      "DocsBlockType",
      "RichBlock",
      "DocsQuizGenerator",
      "parseDocsQuiz",
      "DocsQuizConfig",
      "DocsQuizDocument",
      "DocsQuizGenerationInput",
      "DocsQuizQuestion",
      "DocsQuizQuestionType",
      "DocsWorkspace",
      "DocsLocalWorkspace",
      "DocsLocalPage",
      "DocsLocalWorkspaceProps",
      "DocsContentEditor",
      "renderCallout",
      "renderCode",
      "Embed",
      "renderImage",
      "renderMathBlock",
      "DocsInlineMath",
      "NodesBlock",
      "Raw",
      "renderTable",
      "renderSections",
      "TsDocs",
      "DocsHeading",
      "DOCS_BLOCK_ICONS",
      "ATTCH_TYPES",
      "ExportDialog",
      "DocsExportOpts",
      "ExportTgt",
      "configureDocsHost",
      "getDocsHostAdapter",
      "DocsActionOperation",
      "DocsActionResult",
      "DocsHostOperationContracts",
      "DocsResolvedRoute",
      "DocsCustomBlock",
      "DocsHostAdapter",
      "DocsHostAttachment",
      "DocsHostCapabilities",
      "DocsHostDocument",
      "DocsHostTreeNode",
      "DocsHostUser",
      "DocsWorkspaceProps",
      "DocsAttachment",
      "DocsLeaf",
      "DocsGroup",
      "DocsSection"
    ]
  },
  "documentation": {
    "required": {
      "types": true,
      "functions": true,
      "exportedFunctions": true
    },
    "commandRoots": ["."]
  },
  "typecheckCommand": {
    "command": "pnpm",
    "args": ["exec", "tsc", "--noEmit", "-p", "config/tsconfig.json"]
  },
  "qualityCommands": [
    {
      "name": "demo-typecheck",
      "command": "pnpm",
      "args": ["exec", "tsc", "--noEmit", "-p", "config/tsconfig.demo.json"]
    }
  ],
  "enabledChecks": {
    "document": true,
    "format": true,
    "import": true,
    "name": true,
    "forward": true,
    "accessibility": true,
    "display-name": true,
    "performance-patterns": true,
    "documented-commands": true,
    "lint": true,
    "knip": true,
    "dead-code": true,
    "type": true,
    "recommend": true,
    "command": true,
    "diff": true,
    "alias": true,
    "security": true,
    "repeated-classes": true,
    "tailwind-canonical": true,
    "regex-dedup": true,
    "ui-patterns": true,
    "ui-recommendations": true,
    "error-boundaries": true,
    "github": true
  },
  "performancePatterns": {
    "extensions": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"]
  },
  "security": {
    "runtimeRoots": ["bin", "config", "scripts", "site/config", "test"],
    "allowProcessEnvRoots": ["bin", "config", "scripts", "site/config", "test"],
    "clientRoots": ["site/src"]
  },
  "github": {
    "repositories": ["Terra-Symposium/docs"]
  },
  "autofix": {
    "document": false
  }
}
