{
  "$schema": "../node_modules/@terra-symposium/hygiene/quality.schema.json",
  "tsconfig": "config/tsconfig.json",
  "sourceRoots": ["."],
  "languageProfiles": ["c", "java", "python"],
  "extensions": [
    ".astro",
    ".c",
    ".cjs",
    ".cpp",
    ".cts",
    ".css",
    ".h",
    ".html",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".jsonc",
    ".md",
    ".mdx",
    ".mjs",
    ".mts",
    ".py",
    ".pyi",
    ".rs",
    ".sh",
    ".sql",
    ".toml",
    ".ts",
    ".tsx",
    ".yaml",
    ".yml"
  ],
  "tools": {
    "eslint": "node_modules/.bin/eslint",
    "uv": "uv"
  },
  "regexDedup": {
    "minimumCount": 2,
    "sharedModule": "src/lib/terra/regex.mjs"
  },
  "tailwindCanonical": {
    "stylesheet": "src/styles/style.css"
  },
  "repeatedClasses": {
    "minimumCount": 3
  },
  "uiPatterns": {
    "forbidden": ["<[^>]*\\brole\\s*=\\s*['\"]dialog['\"]", "\\baria-modal\\s*="]
  },
  "frameworkEntryExports": {
    "site/src/components/DocsSiteIsland.tsx": ["DocsSiteIsland"],
    "src/components/LocalDocsWorkspace.tsx": [
      "DocsLocalWorkspace",
      "DocsLocalPage",
      "DocsLocalWorkspaceProps",
      "findDocsLocalPage"
    ],
    "src/components/workspace-demo-fixture.ts": ["createWorkspaceDemoHost"],
    "src/lib/index.ts": [
      "Docs",
      "DocsSiteLayout",
      "DocsStaticWorkspace",
      "DocsMode",
      "DocsProps",
      "DocsValue",
      "DocsNavigation",
      "DocsNavNode",
      "renderMarkdown",
      "markdownToDocsValue",
      "docsValueToMarkdown",
      "DOCS_BLOCK_TYPES",
      "DOCS_BLOCK_FIELDS",
      "enabledDocsBlocks",
      "defaultDocsBlock",
      "DocsRichBlock",
      "DocsBlockOptions",
      "DocsBlockType",
      "RichBlock",
      "DocsQuizGenerator",
      "parseDocsQuiz",
      "DocsQuizConfig",
      "DocsQuizDocument",
      "DocsQuizGenerationInput",
      "DocsQuizQuestion",
      "DocsQuizQuestionType",
      "DocsWorkspace",
      "DocsLocalWorkspace",
      "DocsLocalPage",
      "DocsLocalWorkspaceProps",
      "DocsContentEditor",
      "renderCallout",
      "renderCode",
      "Embed",
      "renderImage",
      "renderMathBlock",
      "DocsInlineMath",
      "NodesBlock",
      "Raw",
      "renderTable",
      "TsDocs",
      "DocsHeading",
      "DOCS_BLOCK_ICONS",
      "ATTCH_TYPES",
      "ExportDialog",
      "DocsExportOpts",
      "ExportTgt",
      "configureDocsHost",
      "getDocsHostAdapter",
      "DocsActionOperation",
      "DocsActionResult",
      "DocsHostOperationContracts",
      "DocsResolvedRoute",
      "DocsCustomBlock",
      "DocsHostAdapter",
      "DocsHostAttachment",
      "DocsHostCapabilities",
      "DocsHostDocument",
      "DocsHostTreeNode",
      "DocsHostUser",
      "DocsWorkspaceProps",
      "DocsAttachment",
      "DocsLeaf",
      "DocsGroup",
      "DocsSection"
    ]
  },
  "documentation": {
    "required": {
      "types": true,
      "functions": true,
      "exportedFunctions": true,
      "importSection": true,
      "fileHeader": true,
      "multilineTsdoc": true
    },
    "commandRoots": ["."]
  },
  "typecheckCommand": {
    "command": "pnpm",
    "args": ["exec", "tsc", "--noEmit", "-p", "config/tsconfig.json"]
  },
  "qualityCommands": [],
  "enabledChecks": {
    "document": true,
    "format": true,
    "import": true,
    "name": true,
    "forward": true,
    "accessibility": true,
    "display-name": true,
    "performance-patterns": true,
    "documented-commands": true,
    "lint": true,
    "knip": true,
    "dead-code": true,
    "type": true,
    "recommend": true,
    "command": true,
    "diff": true,
    "alias": true,
    "security": true,
    "repeated-classes": true,
    "tailwind-canonical": true,
    "regex-dedup": true,
    "ui-patterns": true,
    "ui-recommendations": true,
    "error-boundaries": true,
    "github": true
  },
  "performancePatterns": {
    "extensions": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"]
  },
  "security": {
    "runtimeRoots": [
      "bin/docs.mjs",
      "config/playwright.config.ts",
      "config/playwright.published.config.ts",
      "config/playwright.static.config.ts",
      "scripts/acquire-playwright-port.mjs",
      "scripts/audit-uni-render.mjs",
      "site/config/astro.config.mjs",
      "tests/astro-config-runtime.test.mjs"
    ],
    "clientRoots": ["site/src"]
  },
  "github": {
    "repositories": ["Terra-Symposium/docs"]
  },
  "autofix": {
    "document": false
  }
}
