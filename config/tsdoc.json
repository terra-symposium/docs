{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/tsdoc/v0/tsdoc.schema.json",
  "extends": ["typedoc/tsdoc.json"],
  "noStandardTags": false,
  "tagDefinitions": [
    { "tagName": "@docsId", "syntaxKind": "block" },
    { "tagName": "@docsUseWhen", "syntaxKind": "block" },
    { "tagName": "@docsConstraint", "syntaxKind": "block" },
    { "tagName": "@docsDo", "syntaxKind": "block" },
    { "tagName": "@docsDont", "syntaxKind": "block" },
    { "tagName": "@docsTip", "syntaxKind": "block" },
    { "tagName": "@docsInsertionStep", "syntaxKind": "block" },
    { "tagName": "@docsSyntax", "syntaxKind": "block" },
    { "tagName": "@docsRenderedExample", "syntaxKind": "block" },
    { "tagName": "@docsRenderKind", "syntaxKind": "block" },
    { "tagName": "@docsEditorImage", "syntaxKind": "block" }
  ]
}
