{
  "name": "@terra-symposium/docs",
  "version": "0.4.31",
  "description": "Docs workspace and Markdown site generator.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terra-symposium/docs.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "docs/consumer/0-configuration",
    "docs/consumer/1-usage",
    "dist/lib",
    "bin",
    "template/.gitignore",
    "template/.github/workflows/docs.yml",
    "template/README.md",
    "template/package.json",
    "template/pnpm-workspace.yaml",
    "template/docs/index.md",
    "site",
    "src/components/navigation.tsx",
    "src/components/quiz-demo-fixture.ts",
    "src/components/SiteLayout.astro",
    "src/components/NotFound.astro",
    "src/components/NotFound.tsx",
    "src/lib/terra/regex.mjs"
  ],
  "exports": {
    "./authoring/authoring.md": "./docs/consumer/1-usage/1-authoring.md",
    "./authoring/ideology.md": "./docs/consumer/1-usage/1-authoring.md",
    "./authoring/structure.md": "./docs/consumer/1-usage/1-authoring.md",
    "./authoring/posterity.md": "./docs/consumer/1-usage/4-validation.md",
    "./authoring/validation.md": "./docs/consumer/1-usage/4-validation.md",
    "./authoring/syntax.md": "./docs/consumer/1-usage/0-syntax/index.md",
    "./authoring/blocks.md": "./docs/consumer/1-usage/0-syntax/index.md",
    "./authoring/composing.md": "./docs/consumer/1-usage/1-authoring.md",
    "./authoring/schema-source.md": "./docs/consumer/1-usage/1-authoring.md",
    "./authoring/examples.md": "./docs/consumer/1-usage/0-syntax/index.md",
    "./configuration/component.md": "./docs/consumer/0-configuration/0-install.md",
    ".": {
      "types": "./dist/lib/lib/index.d.ts",
      "import": "./dist/lib/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css",
    "./astro": {
      "types": "./dist/lib/lib/astro.d.ts",
      "import": "./dist/lib/lib/astro.js"
    },
    "./local-workspace": {
      "types": "./dist/lib/components/LocalDocsWorkspace.d.ts",
      "import": "./dist/lib/components/LocalDocsWorkspace.js"
    },
    "./site-layout.astro": "./src/components/SiteLayout.astro",
    "./not-found.astro": "./src/components/NotFound.astro"
  },
  "bin": {
    "docs": "bin/docs.mjs"
  },
  "docs": {
    "title": "Docs",
    "errorReporting": {
      "endpoint": "https://terrasymposium.com/api/error-report",
      "site": "docs"
    },
    "description": "Docs workspace and Markdown site generator.",
    "port": 2020,
    "out": "dist/docs"
  },
  "scripts": {
    "dev": "mkdir -p dist/cache/vite && pnpm run build:dev && node bin/docs.mjs dev --host 127.0.0.1",
    "docs:dev": "pnpm run dev",
    "quality": "node scripts/quality.mjs quality",
    "quality:all": "node scripts/quality.mjs quality --all",
    "quality:check": "pnpm run quality:all",
    "quality:fix": "node scripts/quality.mjs quality --all --fix",
    "docs:sanitize": "python3 scripts/docs-sanitize/cli.py check",
    "docs:sanitize:fix": "python3 scripts/docs-sanitize/cli.py fix",
    "docs": "pnpm run build && node bin/docs.mjs build",
    "build": "rm -rf dist/lib && tsc -p config/tsconfig.json && tailwindcss --postcss config/tailwind.postcss.config.mjs -c config/tailwind.docs.config.mjs -i src/styles/style.css -o dist/lib/style.css --minify && tailwindcss --postcss config/tailwind.postcss.config.mjs -c config/tailwind.docs.config.mjs -i src/styles/workspace.css -o dist/lib/workspace.css --minify && node scripts/copy-runtime.mjs",
    "build:dev": "tsc --noEmitOnError -p config/tsconfig.json && tailwindcss --postcss config/tailwind.postcss.config.mjs -c config/tailwind.docs.config.mjs -i src/styles/style.css -o dist/lib/style.css --minify && tailwindcss --postcss config/tailwind.postcss.config.mjs -c config/tailwind.docs.config.mjs -i src/styles/workspace.css -o dist/lib/workspace.css --minify && node scripts/copy-runtime.mjs",
    "test:browser": "pnpm run build && pnpm exec astro build --config config/astro.config.mjs && node bin/docs.mjs build && playwright test --config config/playwright.config.ts && playwright test --config config/playwright.published.config.ts",
    "check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check . && eslint --config config/eslint.config.js . && tsc --noEmit -p config/tsconfig.json",
    "test:unit": "pnpm run build && node --test tests/*.test.mjs && pnpm --filter @terra-symposium/skills test",
    "skills:prepare": "terra-skills prepare",
    "skills:check": "terra-skills check",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "prepare": "husky config/husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@terra-symposium/hygiene": "2.5.6",
    "@terra-symposium/reporting": "0.8.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "postcss": "8.5.31",
    "postcss-import": "15.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "@terra-symposium/skills": "workspace:0.1.2"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/react": "^7.1.0",
    "@carbon/icons-react": "11.90.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.4",
    "@dagrejs/dagre": "^1.1.4",
    "@lexical/rich-text": "^0.35.0",
    "@portabletext/editor": "7.9.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@terra-symposium/boundaries": "0.2.3",
    "@terra-symposium/styling": "0.1.39",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@xstate/react": "6.1.0",
    "@xyflow/react": "^12.3.6",
    "astro": "^7.4.2",
    "bezier-easing": "2.1.0",
    "html-to-image": "1.11.11",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "lexical": "^0.35.0",
    "marked": "^18.1.1",
    "nanostores": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.4.41",
    "use-sync-external-store": "1.7.0",
    "yaml": "^2.7.0"
  },
  "license": "Apache-2.0"
}
