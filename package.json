{
  "name": "@terra-symposium/docs",
  "version": "0.3.0",
  "description": "Docs workspace and Markdown site generator.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Terra-Symposium/docs.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "dist/lib",
    "bin",
    "site",
    "src/components/navigation.tsx",
    "src/components/quiz-demo-fixture.ts",
    "src/components/SiteLayout.astro",
    "src/components/NotFound.astro",
    "src/components/NotFound.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/lib/index.d.ts",
      "import": "./dist/lib/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css",
    "./astro": {
      "types": "./dist/lib/lib/astro.d.ts",
      "import": "./dist/lib/lib/astro.js"
    },
    "./local-workspace": {
      "types": "./dist/lib/components/LocalDocsWorkspace.d.ts",
      "import": "./dist/lib/components/LocalDocsWorkspace.js"
    },
    "./site-layout.astro": "./src/components/SiteLayout.astro",
    "./not-found.astro": "./src/components/NotFound.astro",
    "./skills": {
      "types": "./site/src/components/SkillsExplorer.tsx",
      "import": "./site/src/components/SkillsExplorer.tsx"
    }
  },
  "bin": {
    "terra-docs": "bin/terra-docs.mjs"
  },
  "scripts": {
    "dev": "terra-quality-dev -- vite --host 127.0.0.1 --open",
    "docs:dev": "pnpm build && node bin/terra-docs.mjs dev --title 'Docs'",
    "docs:build": "pnpm build && node bin/terra-docs.mjs build --title 'Docs'",
    "docs:preview": "pnpm docs:build && node bin/terra-docs.mjs preview --title 'Docs'",
    "dev:library": "tsc --watch",
    "prebuild": "pnpm exec terra-quality error-boundaries --all",
    "build": "rm -rf dist/lib && tsc && tailwindcss --postcss tailwind.postcss.config.cjs -c tailwind.docs.config.mjs -i src/styles/style.css -o dist/lib/style.css --minify && tailwindcss --postcss tailwind.postcss.config.cjs -c tailwind.docs.config.mjs -i src/styles/workspace.css -o dist/lib/workspace.css --minify && node scripts/copy-runtime.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:browser": "pnpm build && pnpm exec astro build --config astro.config.mjs && node scripts/acquire-playwright-port.mjs && playwright test",
    "test:report:slides": "node scripts/generate-screenshot-deck.mjs",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@terra-symposium/standards-quality": "2.1.3",
    "@terra-symposium/standards-reporting": "0.6.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "postcss": "8.5.31",
    "postcss-import": "15.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/react": "^7.1.0",
    "@carbon/icons-react": "11.90.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.4",
    "@dagrejs/dagre": "^1.1.4",
    "@lexical/rich-text": "^0.35.0",
    "@portabletext/editor": "7.9.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "2.4.1",
    "@terra-symposium/standards-error-boundaries": "0.1.2",
    "@terra-symposium/styling": "0.1.34",
    "bezier-easing": "2.1.0",
    "@xstate/react": "6.1.0",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@xyflow/react": "^12.3.6",
    "astro": "^7.4.2",
    "html-to-image": "1.11.11",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "lexical": "^0.35.0",
    "marked": "^18.1.1",
    "nanostores": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sonner": "^1.4.41",
    "use-sync-external-store": "1.7.0",
    "yaml": "^2.7.0"
  },
  "license": "Apache-2.0"
}
