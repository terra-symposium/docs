{
  "name": "@terra-symposium/docs",
  "version": "0.4.6",
  "description": "Docs workspace and Markdown site generator.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Terra-Symposium/docs"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "docs/authoring",
    "dist/lib",
    "bin",
    "site",
    "src/components/navigation.tsx",
    "src/components/quiz-demo-fixture.ts",
    "src/components/SiteLayout.astro",
    "src/components/NotFound.astro",
    "src/components/NotFound.tsx"
  ],
  "exports": {
    "./authoring/blocks.md": "./docs/authoring/blocks/index.md",
    "./authoring/composing.md": "./docs/authoring/composing/index.md",
    ".": {
      "types": "./dist/lib/lib/index.d.ts",
      "import": "./dist/lib/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css",
    "./astro": {
      "types": "./dist/lib/lib/astro.d.ts",
      "import": "./dist/lib/lib/astro.js"
    },
    "./local-workspace": {
      "types": "./dist/lib/components/LocalDocsWorkspace.d.ts",
      "import": "./dist/lib/components/LocalDocsWorkspace.js"
    },
    "./site-layout.astro": "./src/components/SiteLayout.astro",
    "./not-found.astro": "./src/components/NotFound.astro"
  },
  "bin": {
    "docs": "bin/docs.mjs"
  },
  "docs": {
    "title": "Docs",
    "description": "Docs workspace and Markdown site generator.",
    "out": "dist/docs"
  },
  "scripts": {
    "dev": "DOCS_DEV_PORT=2020 terra-quality-dev -- vite --config config/vite.config.ts --host 127.0.0.1 --open",
    "quality": "node scripts/quality.mjs",
    "docs": "pnpm run build && node bin/docs.mjs build",
    "build": "rm -rf dist/lib && tsc -p config/tsconfig.json && tailwindcss --postcss config/tailwind.postcss.config.cjs -c config/tailwind.docs.config.mjs -i src/styles/style.css -o dist/lib/style.css --minify && tailwindcss --postcss config/tailwind.postcss.config.cjs -c config/tailwind.docs.config.mjs -i src/styles/workspace.css -o dist/lib/workspace.css --minify && node scripts/copy-runtime.mjs",
    "test:browser": "playwright test --config config/playwright.config.ts",
    "check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check . && eslint --config config/eslint.config.js . && tsc --noEmit -p config/tsconfig.json && tsc -p config/tsconfig.demo.json",
    "test:unit": "pnpm run build && node --test test/*.test.mjs",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "prepare": "husky config/husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@terra-symposium/standards-quality": "2.1.3",
    "@terra-symposium/standards-reporting": "0.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "postcss": "8.5.31",
    "postcss-import": "15.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/react": "^7.1.0",
    "@carbon/icons-react": "11.90.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.4",
    "@dagrejs/dagre": "^1.1.4",
    "@lexical/rich-text": "^0.35.0",
    "@portabletext/editor": "7.9.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@terra-symposium/standards-error-boundaries": "0.1.2",
    "@terra-symposium/styling": "0.1.34",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@xstate/react": "6.1.0",
    "@xyflow/react": "^12.3.6",
    "astro": "^7.4.2",
    "bezier-easing": "2.1.0",
    "html-to-image": "1.11.11",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "lexical": "^0.35.0",
    "marked": "^18.1.1",
    "nanostores": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.4.41",
    "use-sync-external-store": "1.7.0",
    "yaml": "^2.7.0"
  },
  "license": "Apache-2.0"
}
