---
/**
 * site/src/components/SiteMarkdownPage.astro
 */
/*//////////////////////////////////////////////////
IMPORTS
//////////////////////////////////////////////////*/

import DocsSiteLayout from '../../../src/components/SiteLayout.astro';
import DocsCodeBlock from './DocsCodeBlock.astro';
import DocsNodes from './DocsNodes.astro';
import { pageForSlug, pageHref, siteNavigation } from '../lib/catalog.js';

type Props = { slug: string };
const { slug } = Astro.props;
const title = import.meta.env.PUBLIC_DOCS_TITLE ?? 'Documentation';
const desc = import.meta.env.PUBLIC_DOCS_DESCRIPTION ?? '';
const base = import.meta.env.BASE_URL;
const currentPage = pageForSlug(slug);
const parentSlug = slug.split('/').slice(0, -1).join('/');
const parentPage = pageForSlug(parentSlug);
const Content = currentPage?.file.endsWith('.mdx') ? (currentPage.content as any) : undefined;
const layoutProps = {
	title,
	homeHref: pageHref('', base),
	description: desc,
	pageTitle: currentPage?.title,
	pageDescription: currentPage?.description,
	...(parentPage ? { breadcrumbParent: { title: parentPage.title, href: pageHref(parentSlug, base) } } : {}),
	hue: currentPage?.hue,
	nodes: siteNavigation,
	currentPath: pageHref(slug, base),
	rootPath: pageHref('', base),
	markdown: currentPage?.markdown ?? '',
	sourceMarkdown: currentPage?.sourceMarkdown ?? '',
	sourcePath: currentPage?.file,
	searchBase: base,
};
---

{currentPage ? (
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			{currentPage.description ? <meta name="description" content={currentPage.description} /> : desc ? <meta name="description" content={desc} /> : null}
			<title>{currentPage.title} · {title}</title>
		</head>
		<body>
			{Content ? (
				<DocsSiteLayout {...layoutProps}>
					<main class="copy"><Content components={{ CodeBlock: DocsCodeBlock, Nodes: DocsNodes }} /></main>
				</DocsSiteLayout>
			) : (
				<DocsSiteLayout {...layoutProps} />
			)}
		</body>
	</html>
) : null}
