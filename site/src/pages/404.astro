---
import DocsNotFound from '../../../src/components/NotFound.astro';
import { firstAvailableLeafHref, pageHref } from '../lib/catalog.js';

const title = import.meta.env.PUBLIC_TERRA_DOCS_TITLE ?? 'Documentation';
const base = import.meta.env.BASE_URL;
const homeHref = firstAvailableLeafHref() ?? pageHref('', base);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Page not found · {title}</title>
	</head>
	<body>
		<DocsNotFound appName={title} homeHref={homeHref} />
	</body>
</html>
