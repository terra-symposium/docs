---
/**
 * site/src/pages/[...slug].astro
 */
/*//////////////////////////////////////////////////
IMPORTS
//////////////////////////////////////////////////*/

import SiteMarkdownPage from '../components/SiteMarkdownPage.astro';
import { sitePages } from '../lib/catalog.js';

export function getStaticPaths() {
	const blockPrefix = 'consumer/1-usage/1-syntax/';
	return sitePages
		.filter((page) => {
			const blockSlug = page.slug.slice(blockPrefix.length);
			return page.slug !== '' && page.slug !== '404' && !(page.slug.startsWith(blockPrefix) && !blockSlug.includes('/'));
		})
		.map((page) => ({
			params: { slug: page.slug },
			props: { slug: page.slug },
		}));
}

const { slug = '' } = Astro.props;
---

<SiteMarkdownPage slug={slug} />
