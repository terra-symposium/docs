---
/**
 * site/src/pages/consumer/1-usage/0-syntax/[block].astro
 */
/*//////////////////////////////////////////////////
IMPORTS
//////////////////////////////////////////////////*/

import SiteMarkdownPage from '../../../../components/SiteMarkdownPage.astro';
import { sitePages } from '../../../../lib/catalog.js';

export function getStaticPaths() {
	const blockPrefix = 'consumer/1-usage/0-syntax/';
	return sitePages
		.filter((page) => page.slug.startsWith(blockPrefix) && !page.slug.slice(blockPrefix.length).includes('/'))
		.map((page) => ({
			params: { block: page.slug.slice(blockPrefix.length) },
			props: { slug: page.slug },
		}));
}

const { slug } = Astro.props;
---

<SiteMarkdownPage slug={slug} />
