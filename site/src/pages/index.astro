---
import DocsSiteLayout from '../../../src/components/SiteLayout.astro';
import { firstAvailableLeafHref, pageForSlug, pageHref, siteNavigation } from '../lib/catalog.js';

const dest = firstAvailableLeafHref();
const page = pageForSlug('');
const title = import.meta.env.PUBLIC_DOCS_TITLE ?? 'Documentation';
const desc = import.meta.env.PUBLIC_DOCS_DESCRIPTION ?? '';
const base = import.meta.env.BASE_URL;
---

{dest ? (
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
			<meta http-equiv="refresh" content={`0;url=${dest}`} />
			<link rel="canonical" href={dest} />
		<title>Redirecting · {title}</title>
	</head>
	<body>
		<p>Redirecting to <a href={dest}>the first available page</a>.</p>
	</body>
</html>
 ) : page ? (
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			{page.description ? <meta name="description" content={page.description} /> : desc ? <meta name="description" content={desc} /> : null}
			<title>{page.title} · {title}</title>
		</head>
		<body>
			<DocsSiteLayout
				title={title}
				homeHref={pageHref('', base)}
				 description={desc}
				pageTitle={page.title}
				hue={page.hue}
				nodes={siteNavigation}
				currentPath={pageHref('', base)}
				rootPath={pageHref('', base)}
				markdown={page.markdown}
				searchBase={base}
			/>
		</body>
	</html>
) : null}
