---
/**
 * src/components/SiteLayout.astro
 */
/*//////////////////////////////////////////////////
IMPORTS
//////////////////////////////////////////////////*/

// COMPONENTS
import { DocsSiteIsland } from '../../site/src/components/DocsSiteIsland.js';

// INTEGRATIONS
import AstroErrorBoundary from '@terra-symposium/boundaries/astro-boundary';

// STYLES
import '../../dist/lib/style.css';
import '../../site/src/styles/search.css';

// TYPES
import type { DocsAttachment, DocsSection, DocsTree, DocsNavNode } from '../../dist/lib/lib/index.js';

type Props = {
	title: string;
	homeHref?: string;
	description?: string;
	pageTitle?: string;
	pageDescription?: string;
	breadcrumbParent?: { title: string; href: string };
	hue?: number | null;
	nodes?: DocsNavNode[];
	trees?: DocsTree[];
	/**
	 * @deprecated Use trees.
	 */
	sections?: DocsSection[];
	currentPath: string;
	rootPath?: string;
	markdown?: string;
	sourceMarkdown?: string;
	sourcePath?: string;
	content?: unknown;
	blockGuidanceEntries?: Record<string, unknown>;
	attachments?: DocsAttachment[];
	updatedAt?: string;
	searchBase?: string;
};

const { title, homeHref = '/', description: desc, pageTitle, pageDescription: pageDesc, breadcrumbParent, hue = 145, nodes = [], trees, sections, currentPath, rootPath = '/', markdown = '', sourceMarkdown: srcMarkdown, sourcePath: srcPath, content, blockGuidanceEntries, attachments = [], updatedAt, searchBase = '/' } = Astro.props;
const hasStaticSlot = Astro.slots.has('default');
const staticContent = hasStaticSlot || markdown.trim().length > 0;
const siteIslandProps = {
	title,
	homeHref,
	description: desc,
	pageTitle,
	pageDescription: pageDesc,
	breadcrumbParent,
	hue,
	nodes,
	trees,
	sections,
	currentPath,
	rootPath,
	markdown,
	sourceMarkdown: srcMarkdown,
	sourcePath: srcPath,
	content,
	blockGuidanceEntries,
	attachments,
	updatedAt,
	staticContent,
	searchBase,
};
---

<AstroErrorBoundary title="Documentation could not load" description="The Docs interface failed to start. Reload to try again." reloadLabel="Reload Docs">
	{hasStaticSlot ? (
		<DocsSiteIsland client:load {...siteIslandProps}>
			<slot />
		</DocsSiteIsland>
	) : (
		<DocsSiteIsland client:load {...siteIslandProps} />
	)}
</AstroErrorBoundary>

<script>
	import '../../site/src/scripts/static-code-blocks';
</script>

<style is:global>
	.copy { max-width: 100%; }
</style>
