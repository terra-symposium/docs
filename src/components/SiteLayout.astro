---
/*//////////////////////////////////////////////////
IMPORTS
//////////////////////////////////////////////////*/

// COMPONENTS
import { DocsSiteIsland } from '../../site/src/components/DocsSiteIsland.js';

// INTEGRATIONS
import AstroErrorBoundary from '@terra-symposium/standards-error-boundaries/astro-boundary';

// STYLES
import '../../dist/lib/style.css';
import '../../site/src/styles/search.css';

// TYPES
import type { DocsAttachment, DocsSection, DocsNavNode } from '../../dist/lib/lib/index.js';

type Props = {
	title: string;
	homeHref?: string;
	description?: string;
	pageTitle?: string;
	pageDescription?: string;
	hue?: number | null;
	nodes?: DocsNavNode[];
	sections?: DocsSection[];
	currentPath: string;
	rootPath?: string;
	markdown?: string;
	content?: unknown;
	attachments?: DocsAttachment[];
	updatedAt?: string;
	searchBase?: string;
};

const { title, homeHref = '/', description, pageTitle, pageDescription, hue = 145, nodes = [], sections, currentPath, rootPath = '/', markdown = '', content, attachments = [], updatedAt, searchBase = '/' } = Astro.props;
const hasStaticSlot = Astro.slots.has('default');
const staticContent = hasStaticSlot || markdown.trim().length > 0;
const siteIslandProps = {
	title,
	homeHref,
	description,
	pageTitle,
	pageDescription,
	hue,
	nodes,
	sections,
	currentPath,
	rootPath,
	markdown,
	content,
	attachments,
	updatedAt,
	staticContent,
	searchBase,
};
---

<AstroErrorBoundary title="Documentation could not load" description="The Docs interface failed to start. The error has been recorded for diagnosis." reloadLabel="Reload Docs">
	{hasStaticSlot ? (
		<DocsSiteIsland client:load {...siteIslandProps}>
			<slot />
		</DocsSiteIsland>
	) : (
		<DocsSiteIsland client:load {...siteIslandProps} />
	)}
</AstroErrorBoundary>

<style is:global>
	.docs-page-content { max-width: 100%; }
</style>
