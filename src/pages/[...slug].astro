---
import { DocsLocalWorkspace } from '../components/LocalDocsWorkspace';
import { docsPages, docsTree } from '../lib/docs-catalog';
import '../../dist/lib/style.css';

export function getStaticPaths() {
	return docsPages.map(p => ({
		params: { slug: p.id === 'index' ? undefined : p.id },
		props: { pageId: p.id },
	}));
}

const { pageId } = Astro.props;
const p = docsPages.find(e => e.id === pageId) ?? docsPages[0];
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<title>{p?.title ?? 'Terra Docs'}</title>
	</head>
	<body>
		<DocsLocalWorkspace
			client:load
			tree={docsTree}
			pages={docsPages}
			pathname={Astro.url.pathname}
			title='Terra Docs'
			description='Install and configure independent Terra Docs instances.'
			rootPath='/'
			homePath='/'
		/>
	</body>
</html>
